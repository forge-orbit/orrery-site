---
import { repo, toolGroups } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const points = [
  'One `docker compose pull && docker compose up -d` — add `--profile tls` for automatic HTTPS via Caddy.',
  'Your workspaces, issues, project knowledge and agent activity stay on your own server.',
  'AGPL-3.0 licensed. Every MCP tool has a matching REST endpoint (123 operations total).',
];

const md = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<section class="section" id="self-hosted">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Self-hosted</span>
      <h2>One command to run. One plugin to connect an agent.</h2>
      <p>
        Published to GHCR as a single Docker image (TypeScript on Node 26, Hono, Drizzle, React)
        backed by PostgreSQL 18, with an optional Caddy profile for automatic HTTPS.
      </p>
    </div>

    <div class="panels">
      <div class="panel">
        <div class="panel-head">
          <h3>Run it yourself</h3>
          <span class="tag tag-ok">GHCR · Compose</span>
        </div>
        <pre class="terminal"><code><span class="c"># clone, configure .env, and pull the published image</span>
<span class="p">$ </span>git clone https://github.com/forge-orbit/orrery.git &amp;&amp; cd orrery
<span class="p">$ </span>cp .env.example .env
<span class="p">$ </span>docker compose pull &amp;&amp; docker compose up -d</code></pre>
        <ul class="points">
          {points.map((p) => <li set:html={md(p)} />)}
        </ul>
        <p class="small">
          Full setup, Caddy HTTPS, and upgrades in the
          <a href={`${base}/docs/guides/install/`}>Install guide →</a>
        </p>
      </div>

      <div class="panel">
        <div class="panel-head">
          <h3>Static /mcp &amp; tool contract</h3>
          <span class="tag">39 MCP tools</span>
        </div>
        <pre class="terminal"><code><span class="c"># connect any MCP client directly (or use the plugins above)</span>
<span class="p">$ </span>claude mcp add --transport http orrery \
    https://orrery.example.com/mcp \
    --header "Authorization: Bearer $ORRERY_API_KEY"</code></pre>
        <dl class="tools">
          {
            toolGroups.map((g) => (
              <div>
                <dt>{g.group}</dt>
                <dd>
                  {g.tools.map((t) => (
                    <code>{t}</code>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="small">
          25 of 39 generated tools shown — see the
          <a href={`${base}/docs/reference/mcp-tools/`}>MCP tools reference</a>,
          <a href="#integrations">harness plugins</a>, or the
          <a href={`${base}/docs/guides/connect-agent/`}>Connect an agent guide</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
    /* Let long terminal lines scroll inside the panel instead of widening the page. */
    min-width: 0;
    padding: clamp(22px, 3vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .panel-head h3 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .points {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    position: relative;
    padding-left: 22px;
    color: var(--muted);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
  }

  .tools {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .tools > div {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  dd {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }

  dd code {
    font-size: 0.75rem;
  }

  .small {
    margin-top: auto;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .panels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
