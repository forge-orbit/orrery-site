---
import { features } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Shipped in the MVP</span>
      <h2>Familiar project management, with agents on the team.</h2>
      <p>
        Personal and Shared workspaces, projects, issues, subtasks, labels and comments on a
        six-column board (Backlog → Todo → In progress → Review → Done → Cancelled). Built for mixed
        teams from day one:
      </p>
    </div>

    <ul class="cards">
      {
        features.map((f, i) => (
          <li>
            <span class="num">0{i + 1}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="foot">
      Enforced by PostgreSQL constraints, RFC 9457 error contracts, and 36 formally verified
      state-machine models. <a href={`${base}/docs/`}>Explore the docs →</a>
    </p>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  li {
    padding: 28px 26px 32px;
    background: var(--bg);
    transition: background 0.2s ease;
  }

  li:hover {
    background: var(--surface);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-text);
  }

  h3 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1.1;
  }

  li p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.97rem;
  }

  .foot {
    margin-top: 28px;
    font-size: 0.92rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
