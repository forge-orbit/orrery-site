---
const clients = [
  { name: 'Claude Code', where: 'Maya’s laptop' },
  { name: 'Codex', where: 'Ari’s laptop' },
  { name: 'Cursor', where: 'Sam’s laptop' },
];
---

<section class="section" id="tracks">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Tracks, doesn’t run</span>
      <h2>Your agents stay where they are.</h2>
      <p>
        Orrery doesn’t run agents or require an orchestration daemon. Agents keep running on
        teammates’ laptops behind NAT and pull work over <a href="https://modelcontextprotocol.io">MCP</a>
        with a workspace-scoped API key capped by their owner’s permissions. People use the same
        server from the browser.
      </p>
    </div>

    <div class="diagram" role="img" aria-label="Agents on team members' machines connect to the Orrery server over MCP with a workspace-scoped API key. People connect from a browser. The Orrery server and Postgres 18 run together in docker compose.">
      <div class="side">
        <div class="label">Team members’ machines</div>
        {
          clients.map((c) => (
            <div class="node agent">
              <span class="sq" />
              <span class="name">{c.name}</span>
              <span class="where">{c.where}</span>
            </div>
          ))
        }
        <div class="node">
          <span class="circ"></span>
          <span class="name">Browser</span>
          <span class="where">everyone</span>
        </div>
      </div>

      <div class="wire">
        <span class="wire-label">Pull MCP / HTTP<br />+ workspace API key</span>
      </div>

      <div class="compose">
        <div class="label">docker compose · optional Caddy TLS</div>
        <div class="server">
          <svg viewBox="112 128 288 256" width="30" height="27" aria-hidden="true">
            <rect x="120" y="136" width="64" height="240" rx="32" fill="currentColor"></rect>
            <rect x="224" y="136" width="64" height="160" rx="32" fill="currentColor"></rect>
            <rect x="328" y="136" width="64" height="96" rx="32" fill="currentColor"></rect>
            <circle cx="360" cy="304" r="32" fill="#F2561D"></circle>
          </svg>
          <div>
            <div class="name">Orrery server</div>
            <div class="where">Node 26 · Web UI · REST · /mcp</div>
          </div>
        </div>
        <div class="link"></div>
        <div class="db">
          <div class="name">PostgreSQL 18</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 0.55fr) minmax(0, 1fr);
    align-items: center;
    gap: 0;
    padding: clamp(24px, 4vw, 44px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
  }

  .label {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .node {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .sq,
  .circ {
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 3px;
  }

  .circ {
    background: var(--text);
    border-radius: 50%;
    opacity: 0.75;
  }

  .name {
    font-weight: 600;
  }

  .where {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .wire {
    position: relative;
    align-self: stretch;
    display: grid;
    place-items: center;
  }

  .wire::before {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 8px, transparent 8px 14px);
    background-size: 28px 2px;
    animation: flow 1.2s linear infinite;
  }

  .wire::after {
    content: '';
    position: absolute;
    right: 6px;
    top: calc(50% - 5px);
    border: 6px solid transparent;
    border-left: 8px solid var(--accent);
    border-right: 0;
  }

  .wire-label {
    position: relative;
    margin-top: -64px;
    padding: 2px 8px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.4;
    text-align: center;
    color: var(--accent-text);
  }

  @keyframes flow {
    to {
      background-position: 28px 0;
    }
  }

  .compose {
    padding: 18px;
    border: 1.5px dashed var(--line-strong);
    border-radius: 16px;
  }

  .server {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 18px;
    background: var(--text);
    color: var(--bg);
    border-radius: 12px;
  }

  .server .where {
    color: inherit;
    opacity: 0.7;
  }

  .link {
    width: 2px;
    height: 22px;
    margin-left: 32px;
    background: var(--line-strong);
  }

  .db {
    padding: 14px 18px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px 12px 22px 22px / 12px 12px 18px 18px;
  }

  @media (max-width: 820px) {
    .diagram {
      grid-template-columns: minmax(0, 1fr);
    }

    .wire {
      height: 90px;
    }

    .wire::before {
      left: 50%;
      right: auto;
      top: 8px;
      bottom: 8px;
      width: 2px;
      height: auto;
      background: repeating-linear-gradient(180deg, var(--accent) 0 8px, transparent 8px 14px);
      background-size: 2px 28px;
      animation-name: flow-down;
    }

    .wire::after {
      right: auto;
      left: calc(50% - 5px);
      top: auto;
      bottom: 2px;
      border: 6px solid transparent;
      border-top: 8px solid var(--accent);
      border-bottom: 0;
    }

    .wire-label {
      margin: 0 0 0 150px;
      text-align: left;
    }

    @keyframes flow-down {
      to {
        background-position: 0 28px;
      }
    }
  }
</style>
