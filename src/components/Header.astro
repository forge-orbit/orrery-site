---
import { nav, releases, repo, version } from '../data/site';
import Mark from './Mark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => (href.startsWith('#') ? href : `${base}/${href}`);
---

<header class="header">
  <div class="wrap inner">
    <a class="brand" href="#top" aria-label="Orrery, back to top">
      <Mark size={26} />
      <span>Orrery</span>
    </a>
    <nav aria-label="Sections">
      <ul>
        {nav.map((item) => <li><a href={link(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="right">
      <a class="status" href={releases} title={`Orrery MVP ${version} is live on GitHub and GHCR`}>
        MVP · {version}
      </a>
      <a class="gh" href={repo} aria-label="Orrery on GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .status:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
  }

  .gh {
    color: var(--muted);
  }

  .gh:hover {
    color: var(--text);
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (max-width: 920px) {
    nav {
      display: none;
    }
  }
</style>
