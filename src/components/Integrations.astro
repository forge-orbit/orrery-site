---
import { harnesses, integrationGuarantees, integrationsRepo } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section" id="integrations">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Integrations</span>
      <h2>Plug in your harness in two commands.</h2>
      <p>
        Official plugins from <a href={integrationsRepo}><code>forge-orbit/orrery-integrations</code></a>
        (MIT, zero dependencies) wire Orrery’s static <code>/mcp</code> endpoint, automatic
        run-lifecycle hooks, and live inbox waiting in one step.
      </p>
    </div>

    <div class="plugins">
      <div class="plugin">
        <div class="plugin-head">
          <h3>Claude Code</h3>
          <span class="tag tag-ok">Ready</span>
        </div>
        <pre class="terminal"><code><span class="c"># export ORRERY_URL and ORRERY_API_KEY, then in Claude Code:</span>
<span class="p">&gt; </span>/plugin marketplace add forge-orbit/orrery-integrations
<span class="p">&gt; </span>/plugin install orrery@forge-orbit</code></pre>
        <p class="plugin-note">
          Wires <code>/mcp</code>, <code>orrery.run.hook.v1</code> lifecycle hooks, and live inbox
          waiting (<code>orrery_wait_for_input</code>). Requires Node 22+.
        </p>
      </div>

      <div class="plugin">
        <div class="plugin-head">
          <h3>Codex CLI</h3>
          <span class="tag tag-ok">Ready</span>
        </div>
        <pre class="terminal"><code><span class="c"># install from the Forge Orbit marketplace, then trust in /hooks:</span>
<span class="p">$ </span>codex plugin marketplace add forge-orbit/orrery-integrations
<span class="p">$ </span>codex plugin add orrery@forge-orbit</code></pre>
        <p class="plugin-note">
          Open <code>/hooks</code> in Codex to review and trust the installed lifecycle hooks.
          Requires Node 22+.
        </p>
      </div>
    </div>

    <ul class="guarantees">
      {
        integrationGuarantees.map((g) => (
          <li>
            <h3>{g.title}</h3>
            <p>{g.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="matrix-wrap">
      <div class="matrix-head">
        <span class="matrix-label">Supported harnesses</span>
        <a href={integrationsRepo}>forge-orbit/orrery-integrations →</a>
      </div>
      <ul class="matrix">
        {
          harnesses.map((h) => (
            <li>
              <span class="h-name">{h.name}</span>
              <span class="h-how">{h.how}</span>
              <span class={`tag ${h.status === 'ready' ? 'tag-ok' : 'tag-muted'}`}>
                {h.status === 'ready' ? 'Ready' : 'Planned'}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="foot">
      Using Cursor, Devin, or a cloud agent? Connect straight to <code>/mcp</code> — no local
      plugin needed. <a href={`${base}/docs/guides/connect-agent/`}>Connect an agent guide →</a>
    </p>
  </div>
</section>

<style>
  .plugins {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .plugin {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    padding: clamp(22px, 3vw, 30px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
  }

  .plugin-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .plugin-head h3 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .plugin-note {
    margin-top: auto;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .guarantees {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .guarantees li {
    padding: 22px 24px;
    background: var(--bg);
  }

  .guarantees h3 {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .guarantees p {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .matrix-wrap {
    margin-top: 32px;
  }

  .matrix-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .matrix-head a {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.82rem;
    color: var(--accent-text);
    text-decoration: none;
  }

  .matrix-head a:hover {
    text-decoration: underline;
  }

  .matrix {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .matrix li {
    display: grid;
    grid-template-columns: minmax(180px, 0.9fr) minmax(0, 2fr) auto;
    gap: 12px 20px;
    align-items: center;
    padding: 14px 4px;
    border-bottom: 1px solid var(--line);
  }

  .h-name {
    font-weight: 600;
  }

  .h-how {
    font-size: 0.92rem;
    color: var(--muted);
  }

  .foot {
    margin-top: 28px;
    font-size: 0.92rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .plugins {
      grid-template-columns: minmax(0, 1fr);
    }

    .guarantees {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .matrix li {
      grid-template-columns: 1fr auto;
    }

    .h-how {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
