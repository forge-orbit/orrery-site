---
import { integrationsRepo, releases, repo } from '../data/site';
import Mark from './Mark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer>
  <div class="wrap inner">
    <div class="brand">
      <Mark size={22} />
      <span>Orrery</span>
    </div>
    <ul>
      <li><a href={repo}>GitHub</a></li>
      <li><a href={integrationsRepo}>Integrations</a></li>
      <li><a href={releases}>Releases</a></li>
      <li><a href={`${base}/docs/`}>Docs</a></li>
      <li><a href={`${repo}/blob/main/LICENSE`}>AGPL-3.0 license</a></li>
    </ul>
    <p>Built by <a href="https://github.com/forge-orbit">Forge Orbit</a></p>
  </div>
</footer>

<style>
  footer {
    padding-block: 40px 56px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 36px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    color: var(--text);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }

  p {
    margin-left: auto;
  }

  /* Once the row wraps, stack and center everything instead of leaving "Built by" stranded. */
  @media (max-width: 720px) {
    .inner {
      flex-direction: column;
      gap: 18px;
      text-align: center;
    }

    ul {
      justify-content: center;
    }

    p {
      margin-left: 0;
    }
  }
</style>
